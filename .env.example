# ==============================================================================
# SIGAP SMART MANUFACTURING AGENTIC PLATFORM - ENVIRONMENT CONFIGURATION
# Track: Intelligence Manufacturing | Host: SOKRATES x BINUS 2026
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DATABASE CONFIGURATION (PRISMA 6 ORM - POSTGRESQL)
# ------------------------------------------------------------------------------
# Production / Staging: AWS RDS PostgreSQL (Free Tier: db.t4g.micro / 750 hrs/month)
# Parameter sslmode=require wajib untuk endpoint AWS RDS.
DATABASE_URL="postgresql://sigap_admin:YourStrongPassword@sigap-postgres.c123456789.ap-southeast-1.rds.amazonaws.com:5432/sigap_db?sslmode=require"

# Development / Local Fallback (Docker / Local PostgreSQL / Neon Sandbox)
# DATABASE_URL="postgresql://postgres:admin123@localhost:5432/sigap_db?schema=public"

NODE_ENV="development"

# ------------------------------------------------------------------------------
# 2. AWS INTEGRATION (BEDROCK REASONING & S3 IMAGE STORAGE)
# ------------------------------------------------------------------------------
# Region rekomendasi: ap-southeast-1 (Singapore) atau us-east-1 (N. Virginia)
AWS_REGION="ap-southeast-1"
AWS_ACCESS_KEY_ID="AKIAXXXXXXXXXXXXXXXX"
AWS_SECRET_ACCESS_KEY="XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX"

# S3 Bucket untuk frame foto inspeksi cacat conveyor
AWS_S3_BUCKET_NAME="sigap-inspection-frames"

# Model Bedrock untuk Deductive Causality Reasoning:
# Opsi 1 (REKOMENDASI UTAMA - AWS Native, ~16x Lebih Hemat & Super Cepat): "amazon.nova-lite-v1:0"
#   - Biaya: $0.06 / 1M input, $0.24 / 1M output (16.7x lebih murah dari Haiku)
#   - Latensi: TTFT sangat cepat (<300ms), ideal untuk real-time manufacturing shop-floor
#   - First-party foundation model resmi AWS (Sponsor Hackathon)
# Opsi 2 (Alternatif Frontier Cepat): "anthropic.claude-3-5-haiku-20241022-v1:0"
# Opsi 3 (Penalaran Kompleks): "anthropic.claude-3-5-sonnet-20240620-v1:0"
# Opsi 4 (Open Weights): "meta.llama3-8b-instruct-v1:0"
AWS_BEDROCK_MODEL_ID="amazon.nova-lite-v1:0"

# ------------------------------------------------------------------------------
# 3. SAP ERP INTEGRATION (ODATA V4 CLIENT & MOCK LAYER)
# ------------------------------------------------------------------------------
# Mode SAP: "mock" (Zero-cost dev lokal) atau "live" (Jika telah menerima tenant Top 40)
SAP_MODE="mock"

# Base URL untuk OData Mock Endpoints internal Next.js
SAP_ODATA_BASE_URL="http://localhost:3000/api/mock/sap"

# Konfigurasi SAP BTP Destination Service (Diaktifkan pada tahap Finalis)
# SAP_BTP_DESTINATION_URL="https://your-tenant.authentication.sap.hana.ondemand.com"
# SAP_CLIENT_ID="sb-sigap-client!b123"
# SAP_CLIENT_SECRET="xxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# ------------------------------------------------------------------------------
# 4. INTERNAL WEBHOOK AUTHENTICATION & EDGE SECURITY
# ------------------------------------------------------------------------------
# Kunci rahasia bersama untuk transmisi data dari Edge Vision YOLOv8 & Agent Worker
INTERNAL_API_KEY="sigap-internal-dev-key-2026"
EDGE_CAMERA_API_KEY="sigap-edge-cam-secret-key-2026"
