# ==============================================================================
# SIGAP SMART MANUFACTURING - ENVIRONMENT CONFIGURATION
# ==============================================================================

NODE_ENV="development"

# ------------------------------------------------------------------------------
# 1. DATABASE (PRISMA 6 ORM - POSTGRESQL)
# ------------------------------------------------------------------------------
# AWS RDS PostgreSQL (Production/Staging) or Local / Neon PostgreSQL
DATABASE_URL="postgresql://sigap_admin:YourStrongPassword@sigap-postgres.c123456789.ap-southeast-1.rds.amazonaws.com:5432/sigap_db?sslmode=require"

# ------------------------------------------------------------------------------
# 2. AWS INTEGRATION (BEDROCK AI REASONING & S3 STORAGE)
# CATATAN KHUSUS AWS AMPLIFY:
# Konsol AWS Amplify melarang nama variabel berawalan "AWS_".
# Gunakan prefix "SIGAP_" di konsol Amplify (akan otomatis dimetakan ke SDK AWS):
SIGAP_AWS_REGION="us-east-1"
SIGAP_AWS_ACCESS_KEY_ID="AKIAXXXXXXXXXXXXXXXX"
SIGAP_AWS_SECRET_ACCESS_KEY="XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX"
SIGAP_BEDROCK_MODEL_ID="amazon.nova-lite-v1:0"
SIGAP_S3_BUCKET_NAME="sigap-inspection-frames"
SIGAP_S3_REGION="ap-southeast-2"

# Format Standar AWS SDK (Local Development):
AWS_REGION="us-east-1"
AWS_ACCESS_KEY_ID="AKIAXXXXXXXXXXXXXXXX"
AWS_SECRET_ACCESS_KEY="XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX"
AWS_BEDROCK_MODEL_ID="amazon.nova-lite-v1:0"
AWS_S3_BUCKET_NAME="sigap-inspection-frames"
AWS_S3_REGION="ap-southeast-2"

# ------------------------------------------------------------------------------
# 3. SAP ERP INTEGRATION (ODATA V4)
# ------------------------------------------------------------------------------
# Mode SAP: "mock" (simulasi lokal zero-cost) | "live" (koneksi SAP BTP aktual)
SAP_MODE="mock"
SAP_ODATA_BASE_URL="http://localhost:3000/api/mock/sap"

# Kredensial SAP BTP Destination (Diperlukan jika SAP_MODE="live")
# SAP_BTP_DESTINATION_URL="https://your-tenant.authentication.sap.hana.ondemand.com"
# SAP_CLIENT_ID="sb-sigap-client!b123"
# SAP_CLIENT_SECRET="xxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# ------------------------------------------------------------------------------
# 4. INTERNAL WEBHOOK AUTHENTICATION
# ------------------------------------------------------------------------------
# Shared secret key untuk komunikasi Edge Vision (YOLOv8) & Agent Worker ke Next.js
INTERNAL_API_KEY="sigap-internal-dev-key-2026"
EDGE_CAMERA_API_KEY="sigap-edge-cam-secret-key-2026"

# Per-device bearer token used by the edge script / test harness
# SIGAP_DEVICE_TOKEN="..."
# SIGAP_TEST_MODE="1"   # lets INTERNAL_API_KEY stand in for a device token (tests only)
# Base URL scripts call (worker, e2e)
# SIGAP_BASE_URL="http://localhost:3000"

# ------------------------------------------------------------------------------
# 4b. AI PROVIDER & EVIDENCE STORE
# ------------------------------------------------------------------------------
# SIGAP_AI_PROVIDER="bedrock"          # "bedrock" | "sap-ai-core"
# SIGAP_BEDROCK_MAX_TOKENS="600"       # integer 256-1200
# SIGAP_SAP_AI_CORE_SERVICE_KEY_JSON='{...}'
# SIGAP_EVIDENCE_STORE="s3"            # "s3" | "local" (local = ephemeral disk on Amplify)

# ------------------------------------------------------------------------------
# 4c. SESSION / USERS
# ------------------------------------------------------------------------------
# SIGAP_SESSION_SECRET="long-random-string"
# SIGAP_USERS_JSON='[{"id":"sup-1","role":"supervisor","passwordHash":"<base64>"}]'  # see lib/auth.ts

# ------------------------------------------------------------------------------
# 5. DEMO LOGIN
# ------------------------------------------------------------------------------
# The homepage "Demo Supervisor" button signs in as the first supervisor in SIGAP_USERS_JSON
# without a password. Set to "off" to disable it (do this after demo day on a public deploy).
# SIGAP_DEMO_LOGIN="off"
